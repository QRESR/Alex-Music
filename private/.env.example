# Скопируйте этот файл в private/.env.music-proxy и заполните СВОИМИ значениями.
#   cp private/.env.example private/.env.music-proxy
#
# Секреты хранятся ТОЛЬКО здесь (каталог private/ в .gitignore — в git не попадает).
# Пустые значения = функция выключена. Минимум для работы: LLM_API_KEY.

# ── LLM (понимание запросов, /smart) ────────────────────────────────
# Любой OpenAI-совместимый шлюз. Пример для своего/предоставленного LLM:
LLM_ENABLED=1
LLM_BASE_URL=https://ваш-llm-шлюз/v1
LLM_MODEL=ваша-модель
LLM_API_KEY=*** LLM сюда>>

# ── Быстрый LLM (опционально, для intent) ───────────────────────────
# LLM_FAST_BASE_URL=
# LLM_FAST_MODEL=
# LLM_FAST_API_KEY=

# ── Озвучка фраз (TTS, опционально) ─────────────────────────────────
TTS_ENABLED=0
TTS_VOICE=alena

# ── Ранжер/похожие (флаги) ──────────────────────────────────────────
USE_NEW_RANKER=1
USE_SIMILAR_V2=1

# ── Прочие секреты — ОТДЕЛЬНЫЕ файлы в private/ ─────────────────────
# Яндекс Музыка (основной источник):
#   private/yandex-token.txt    <- OAuth-токен Яндекс.Музыки (одной строкой)
#   private/yandex-proxy.txt    <- опционально, прокси http://user:pass@host:port
# ВК Музыка (источник-переключатель):
#   private/vk-cookies.txt      <- куки авторизованного ВК-аккаунта (p, remixsid…)
# YouTube (не используется в текущей сборке):
#   private/youtube-cookies.txt
